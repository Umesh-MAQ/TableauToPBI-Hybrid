  "measures": [
    {
      "table": "loan",
      "name": "Averag Interest Rate",
      "dax": "SUM(loan[int_rate])",
      "formatString": "0.00",
      "displayFolder": "Interest",
      "description": "Tableau calc 'Averag Interest Rate' = SUM([int_rate]).",
      "source": "llm"
    },
    {
      "table": "loan",
      "name": "Default Rate",
      "dax": "DIVIDE(SUM(loan[Default Flag]), COUNT(loan[loan_id]))",
      "formatString": "0.00%",
      "displayFolder": "Risk",
      "description": "Share of loans charged off = SUM([Default Flag]) / COUNT([loan_id]).",
      "source": "llm"
    },
    {
      "table": "loan",
      "name": "Default Risk Category",
      "dax": "IF([Default Rate] > 0.2, \"High Risk\", \"Safe\")",
      "formatString": null,
      "displayFolder": "Risk",
      "description": "High Risk when Default Rate exceeds 20%, else Safe.",
      "source": "llm"
    },
    {
      "table": "loan",
      "name": "YoY Growth %",
      "dax": "VAR _yr = SELECTEDVALUE(loan[issue_year])\nVAR _cur = COUNT(loan[loan_id])\nVAR _prev = CALCULATE(COUNT(loan[loan_id]), REMOVEFILTERS(loan[issue_year]), loan[issue_year] = _yr - 1)\nRETURN DIVIDE(_cur - _prev, _prev)",
      "formatString": "0.0%",
      "displayFolder": "Trend",
      "description": "Year-over-year change in loan count vs the prior issue_year (LOOKUP(-1)).",
      "source": "llm"
    },
    {
      "table": "loan",
      "name": "Highlight Peak Year",
      "dax": "VAR _cur = COUNT(loan[loan_id])\nVAR _peak = MAXX(ALLSELECTED(loan[issue_year]), CALCULATE(COUNT(loan[loan_id])))\nRETURN IF(_cur = _peak, \"Peak\", \"Normal\")",
      "formatString": null,
      "displayFolder": "Trend",
      "description": "Peak when this year's loan count equals the WINDOW_MAX across years, else Normal.",
      "source": "llm"
    },
    {
      "table": "loan",
      "name": "State Rank",
      "dax": "RANKX(ALLSELECTED(state_region[state]), CALCULATE(SUM(loan[loan_amount])), , DESC, Dense)",
      "formatString": "0",
      "displayFolder": "Geography",
      "description": "Descending rank of states by total loan amount (Tableau RANK desc).",
      "source": "llm"
    },
    {
      "table": "loan",
      "name": "Top N",
      "dax": "SELECTEDVALUE('Top N Parameter'[Top N], 10)",
      "formatString": "0",
      "displayFolder": "Geography",
      "description": "Selected Top N value from the Top N Parameter slicer (default 10).",
      "source": "llm"
    },
    {
      "table": "loan",
      "name": "Top N Filter",
      "dax": "IF([State Rank] <= [Top N], TRUE(), FALSE())",
      "formatString": null,
      "displayFolder": "Geography",
      "description": "TRUE when the state is within the Top N by loan amount (Tableau INDEX() <= [Top N]).",
      "source": "llm"
    }
  ],
