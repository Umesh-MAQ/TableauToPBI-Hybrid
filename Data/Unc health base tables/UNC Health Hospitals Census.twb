            <column caption='Filter Extract Date' datatype='boolean' name='[Calculation_1004584216509865986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 6]&#13;&#10;when &apos;Last 48 hours&apos; then datediff(&apos;hour&apos;,[EXTRACT_DATETIME],[Calculation_1004584216509775873])&lt;=48&#13;&#10;when &apos;Last 10 days&apos; then datediff(&apos;hour&apos;,[EXTRACT_DATETIME],[Calculation_1004584216509775873])&lt;=10*24&#13;&#10;when &apos;Last 30 days&apos; then datediff(&apos;hour&apos;,[EXTRACT_DATETIME],[Calculation_1004584216509775873])&lt;=30*24&#13;&#10;when &apos;Custom Month&apos; then datediff(&apos;month&apos;,[Parameters].[Parameter 7],[EXTRACT_DATETIME])=0&#13;&#10;when &apos;Last 13 Months&apos; then [Calculation_2015923796532211714] &lt;= 2&#13;&#10;else null end' />
