                <run fontalignment='1'>Æ&#10;</run>
                <run fontalignment='1' fontcolor='#787878' fontsize='8'>Occ % = (Occ + Unavail) / Staffed</run>
                <run fontalignment='1'>Æ&#10;</run>
                <run fontalignment='1' fontcolor='#787878' fontsize='8'> = (</run>
                <run bold='true' fontalignment='1' fontcolor='#ff0000' fontsize='8'>&lt;!Missing Field!&gt;</run>
                <run fontalignment='1' fontcolor='#787878' fontsize='8'> + ) / </run>
