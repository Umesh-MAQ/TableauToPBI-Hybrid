                <run fontalignment='1'>Æ&#10;&#10;</run>
                <run fontalignment='1' fontcolor='#515151'>Staffed </run>
                <run bold='true' fontalignment='1' fontcolor='#515151'>% Occupancy</run>
                <run fontalignment='1' fontcolor='#515151'>: </run>
                <run bold='true' fontalignment='1' fontcolor='#515151'><![CDATA[<[sqlproxy.1gcxw350njnafm1bo4tym176gmov].[usr:Calculation_2047730516384444416:qk:7]>]]></run>
                <run fontalignment='1'>Æ&#10;&#10;</run>
                <run fontalignment='1' fontcolor='#787878' fontsize='8'>Formula: </run>
                <run fontalignment='1'>Æ&#10;</run>
                <run fontalignment='1' fontcolor='#787878' fontsize='8'>Occ % = (Occ + Unavail) / Staffed</run>
                <run fontalignment='1'>Æ&#10;</run>
                <run fontalignment='1' fontcolor='#787878' fontsize='8'><![CDATA[<[sqlproxy.1gcxw350njnafm1bo4tym176gmov].[usr:Calculation_2047730516384444416:qk:7]> = (<[sqlproxy.1gcxw350njnafm1bo4tym176gmov].[sum:occupied_beds:qk]> + <[sqlproxy.1gcxw350njnafm1bo4tym176gmov].[sum:unavailable_beds:qk]>) / <[sqlproxy.1gcxw350njnafm1bo4tym176gmov].[sum:staffed_beds:qk]>]]></run>
                <run fontalignment='1'>Æ&#10;&#10;</run>
                <run fontalignment='1' fontcolor='#787878' fontsize='8'>Thresholds:</run>
                <run fontalignment='1'>Æ&#10;</run>
