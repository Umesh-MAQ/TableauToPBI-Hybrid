        <calculation class='tableau' formula='if first()=0 and sum([staffed_beds])!=0 and attr([is_topofhour])=1 then str(sum([staffed_beds]))+&apos; (&apos;+str(sum([physical_beds]))+&apos;)&apos; else null end'>
