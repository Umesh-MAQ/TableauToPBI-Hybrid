    <worksheet name='colors occ%'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='8'>% Staffed Occupancy Color Legend</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='UNC Health Hospitals Census' name='sqlproxy.1gcxw350njnafm1bo4tym176gmov' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Threshold Red' datatype='integer' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='91'>
              <calculation class='tableau' formula='91' />
            </column>
            <column caption='Threshold Green' datatype='integer' datatype-customized='true' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='88'>
              <calculation class='tableau' formula='88' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.1gcxw350njnafm1bo4tym176gmov'>
            <column caption='Filters Applied' datatype='integer' name='[Calculation_1409063737828036610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Calculation_1568378635669266432] : COUNTD([Calculation_1568378635669266432])}&#13;&#10;&#13;&#10;//COUNTD([Entity]) = &#13;&#10;&#13;&#10;//{ Fixed: COUNTD([Filter Entity]) }' />
            </column>
            <column caption='min(0)' datatype='integer' name='[Calculation_1504765290895982592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='min(0)' />
            </column>
            <column caption='Filter Entity' datatype='string' name='[Calculation_1568378635669266432]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_910008659161817088]' />
            </column>
            <column caption='Licensed' datatype='string' name='[Calculation_1568378635679965189]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str([licensed_beds])' />
            </column>
            <column caption='HDR' datatype='integer' name='[Calculation_1668865141140516883]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1504765290895982592]' />
            </column>
            <column caption='% Occ.' datatype='real' default-format='p0.0%' name='[Calculation_2047730516384444416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(window_sum(sum([occupied_beds]))+window_sum(sum([unavailable_beds])))/window_sum(sum([staffed_beds]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='LI' datatype='string' name='[Calculation_2093047930949750784]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str([Calculation_1568378635679965189])' />
            </column>
            <column caption='Label Yellow Threshold' datatype='string' name='[Calculation_49539661616189440]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str([Parameters].[Parameter 1]-1)+&quot;-&quot;+str([Parameters].[Parameter 2])' />
            </column>
            <column caption='Label Occupancy Threshold Color' datatype='string' name='[Calculation_590534526122201096]' role='measure' type='nominal'>
              <calculation class='tableau' formula='case [Calculation_967429556094963716]&#13;&#10;when &apos;Green&apos; then &apos;Green: &lt;&apos;+str([Parameters].[Parameter 2])+&apos;%&apos;&#13;&#10;when &apos;Yellow&apos; then &apos;Yellow: &apos;+[Calculation_49539661616189440]+&apos;%&apos;&#13;&#10;when &apos;Red&apos; then &apos;Red: ≥&apos;+str([Parameters].[Parameter 1])+&apos;%&apos;&#13;&#10;else null end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Entity' datatype='string' name='[Calculation_910008659161817088]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [parent_revenue_location_name]&#13;&#10;&#13;&#10;WHEN &apos;Appalachian Regional Behavioral Health&apos; THEN &apos;APPALACHIAN REGIONAL&apos;&#13;&#10;WHEN &apos;BLUE RIDGE HOSPITAL&apos; THEN &apos;BLUE RIDGE&apos;&#13;&#10;WHEN &apos;CALDWELL HOSPITAL&apos; THEN &apos;CALDWELL&apos;&#13;&#10;WHEN &apos;Charles A Cannon Jr Memorial Hospital&apos; then &apos;CANNON&apos;&#13;&#10;WHEN &apos;CHATHAM HOSPITAL&apos; THEN &apos;CHATHAM&apos;&#13;&#10;WHEN &apos;JOHNSTON HOSPITAL&apos; THEN &apos;JOHNSTON&apos;&#13;&#10;WHEN &apos;Lenoir Memorial Hospital&apos; THEN &apos;LENOIR&apos;&#13;&#10;WHEN &apos;NASH HOSPITAL&apos; THEN &apos;NASH&apos;&#13;&#10;WHEN &apos;PARDEE HOSPITAL&apos; THEN &apos;PARDEE&apos;&#13;&#10;WHEN &apos;REX HOSPITAL&apos; THEN &apos;REX&apos;&#13;&#10;WHEN &apos;SOUTHEASTERN REGIONAL HOSPITAL&apos; THEN &apos;SOUTHEASTERN&apos;&#13;&#10;WHEN &apos;UNC ROCKINGHAM HOSPITAL&apos; THEN &apos;ROCKINGHAM&apos;&#13;&#10;WHEN &apos;Watauga Medical Center&apos; THEN &apos;WATAUGA&apos;&#13;&#10;WHEN &apos;Wayne Memorial Hospital&apos; THEN &apos;WAYNE&apos;&#13;&#10;&#13;&#10;ELSE trim(upper([parent_revenue_location_name]))&#13;&#10;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;UNC  HOSPICE&quot;' value='UNC HOSPICE' />
              </aliases>
            </column>
            <column caption='Occupancy Threshold Color' datatype='string' name='[Calculation_967429556094963716]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_2047730516384444416]&gt;=[Parameters].[Parameter 1]/100 then &apos;Red&apos;&#13;&#10;elseif [Calculation_2047730516384444416]&lt;[Parameters].[Parameter 2]/100 then &apos;Green&apos;&#13;&#10;elseif isnull([Calculation_2047730516384444416]) then &apos;&apos;&#13;&#10;else &apos;Yellow&apos; end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='1.5' datatype='real' name='[Calculation_967429556112396304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1.5' />
            </column>
            <column caption='Level Of Care ' datatype='string' name='[Level Of Care (group)]' role='dimension' type='nominal'>
