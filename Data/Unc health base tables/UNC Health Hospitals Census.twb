            <column caption='datediff' datatype='integer' name='[Calculation_2015923796532211714]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[Calculation_2015923796528525312],[max extract datetime (copy)_2015923796531941377])' />
