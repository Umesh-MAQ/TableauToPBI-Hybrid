  <aliases enabled='yes' />
  <column caption='Days' datatype='integer' default-format='n#,##0;-#,##0' name='[% Occ. (copy) (copy)_1326873053240426497]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([extract_date])' />
  </column>
  <column caption='Avg Census' datatype='real' default-format='n#,##0;-#,##0' name='[% Occ. (copy)_1326873053239902208]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='(window_sum(sum([occupied_beds])))/window_sum(COUNTD([extract_date]))'>
      <table-calc ordering-type='Rows' />
    </calculation>
  </column>
  <column caption='Selected Grouping' datatype='string' name='[Calculation_1004584216506126336]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='case [Parameters].[Parameter 5]&#13;&#10;when &apos;Entity&apos; then [Calculation_910008659161817088]&#13;&#10;when &apos;Entity Site&apos; then [Calculation_967429556087681024]&#13;&#10;when &apos;Level Of Care&apos; then [Level Of Care (group)]&#13;&#10;when &apos;Department&apos; then [department_name]&#13;&#10;else null end' />
  </column>
  <column caption='max extract datetime' datatype='datetime' name='[Calculation_1004584216509775873]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='{fixed:max([EXTRACT_DATETIME])}' />
  </column>
  <column caption='Filter Extract Date' datatype='boolean' name='[Calculation_1004584216509865986]' role='dimension' type='nominal'>
