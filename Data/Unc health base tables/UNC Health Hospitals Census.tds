  <column caption='Entity' datatype='string' name='[Calculation_910008659161817088]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CASE [parent_revenue_location_name]&#13;&#10;&#13;&#10;WHEN &apos;Appalachian Regional Behavioral Health&apos; THEN &apos;APPALACHIAN REGIONAL&apos;&#13;&#10;WHEN &apos;BLUE RIDGE HOSPITAL&apos; THEN &apos;BLUE RIDGE&apos;&#13;&#10;WHEN &apos;CALDWELL HOSPITAL&apos; THEN &apos;CALDWELL&apos;&#13;&#10;WHEN &apos;Charles A Cannon Jr Memorial Hospital&apos; then &apos;CANNON&apos;&#13;&#10;WHEN &apos;CHATHAM HOSPITAL&apos; THEN &apos;CHATHAM&apos;&#13;&#10;WHEN &apos;JOHNSTON HOSPITAL&apos; THEN &apos;JOHNSTON&apos;&#13;&#10;WHEN &apos;Lenoir Memorial Hospital&apos; THEN &apos;LENOIR&apos;&#13;&#10;WHEN &apos;NASH HOSPITAL&apos; THEN &apos;NASH&apos;&#13;&#10;WHEN &apos;PARDEE HOSPITAL&apos; THEN &apos;PARDEE&apos;&#13;&#10;WHEN &apos;REX HOSPITAL&apos; THEN &apos;REX&apos;&#13;&#10;WHEN &apos;SOUTHEASTERN REGIONAL HOSPITAL&apos; THEN &apos;SOUTHEASTERN&apos;&#13;&#10;WHEN &apos;UNC ROCKINGHAM HOSPITAL&apos; THEN &apos;ROCKINGHAM&apos;&#13;&#10;WHEN &apos;Watauga Medical Center&apos; THEN &apos;WATAUGA&apos;&#13;&#10;WHEN &apos;Wayne Memorial Hospital&apos; THEN &apos;WAYNE&apos;&#13;&#10;&#13;&#10;ELSE trim(upper([parent_revenue_location_name]))&#13;&#10;&#13;&#10;END' />
  </column>
  <column caption='Entity Site' datatype='string' name='[Calculation_967429556087681024]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF FIND([revenue_location_name],&apos;HBR&apos;) &gt; 0 AND [parent_revenue_location_name] = &apos;UNC HOSPITALS&apos; THEN &apos;HILLSBOROUGH&apos; &#13;&#10;ELSEIF  FIND([revenue_location_name],&apos;JHH&apos;) &gt; 0 AND [parent_revenue_location_name] = &apos;JOHNSTON HOSPITAL&apos; THEN &apos;JOHNSTON - JHH&apos; &#13;&#10;ELSEIF FIND([revenue_location_name],&apos;JHCH&apos;) &gt; 0 AND [parent_revenue_location_name] = &apos;JOHNSTON HOSPITAL&apos; THEN &apos;JOHNSTON - JHCH&apos; &#13;&#10;ELSEIF FIND([revenue_location_name],&apos;RHSH&apos;) &gt; 0 AND [parent_revenue_location_name] = &apos;REX HOSPITAL&apos; THEN &apos;HOLLY SPRINGS&apos; &#13;&#10;ELSEIF FIND([revenue_location_name],&apos;RHSH&apos;) &gt; 0 AND [parent_revenue_location_name] = &apos;REX HOSPITAL&apos; THEN &apos;HOLLY SPRINGS&apos; &#13;&#10;ELSEIF FIND([revenue_location_name],&apos;BRMH&apos;) &gt; 0 AND [parent_revenue_location_name] = &apos;BLUE RIDGE HOSPITAL&apos; THEN &apos;BLUE RIDGE MEMORIAL&apos; &#13;&#10;ELSEIF FIND([revenue_location_name],&apos;BRVH&apos;) &gt; 0 AND [parent_revenue_location_name] = &apos;BLUE RIDGE HOSPITAL&apos; THEN &apos;BLUE RIDGE VALLEY&apos; &#13;&#10;ELSEIF [Calculation_910008659161817088]=&apos;UNC HOSPITALS&apos; then [revenue_location_name]&#13;&#10;ELSE [Calculation_910008659161817088] END' />
  </column>
  <column caption='Occupancy Threshold Color' datatype='string' name='[Calculation_967429556094963716]' role='measure' type='nominal'>
    <calculation class='tableau' formula='if [Calculation_2047730516384444416]&gt;=[Parameters].[Parameter 1]/100 then &apos;Red&apos;&#13;&#10;elseif [Calculation_2047730516384444416]&lt;[Parameters].[Parameter 2]/100 then &apos;Green&apos;&#13;&#10;elseif isnull([Calculation_2047730516384444416]) then &apos;&apos;&#13;&#10;else &apos;Yellow&apos; end'>
      <table-calc ordering-type='Rows' />
    </calculation>
  </column>
